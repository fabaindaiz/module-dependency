{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(hatch run build:gate)",
      "Bash(hatch run build:tests)",
      "Bash(hatch run build:typecheck)",
      "Bash(hatch run build:audit)",
      "Bash(hatch run build:coverage)",
      "Bash(hatch run build:stubs)",
      "Bash(hatch run docs:build)",
      "Bash(hatch build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)"
    ],
    "deny": [
      "Edit(stubs/**)",
      "Write(stubs/**)",
      "Edit(site/**)",
      "Write(site/**)",
      "Edit(dist/**)",
      "Write(dist/**)"
    ]
  }
}
